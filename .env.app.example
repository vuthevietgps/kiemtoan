# Copy to .env.app, replace every secret, then run compose.app.yml.
# Use a URL-encoded password in APP_DATABASE_URL if it contains reserved URL characters.
APP_DB_PASSWORD=replace-with-strong-password
APP_DATABASE_URL=postgresql://app:replace-with-strong-password@database:5432/appdb
JWT_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_KEY=0123456789abcdef0123456789abcdef
APP_ORIGIN=http://localhost:8082
APP_BIND_ADDRESS=127.0.0.1
APP_WEB_PORT=8082
# Account activation/recovery emails; configure a trusted SMTP relay/provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
