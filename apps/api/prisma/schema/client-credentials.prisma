// Module: client-credentials (đặc tả 09 — kho tài khoản khách hàng và chữ ký số)

enum CredentialType {
  TAX_PORTAL // Cổng thuế điện tử
  SOCIAL_INSURANCE // BHXH
  E_INVOICE // Hoá đơn điện tử
  EMAIL
  DIGITAL_SIGNATURE // Chữ ký số (token)
  OTHER // Khác — bắt buộc nhập tên (L1)
}

enum CredentialStatus {
  ACTIVE // Đang dùng được
  ERROR // Lỗi đăng nhập
  NEED_CHANGE // Cần đổi mật khẩu
}

// Nhà cung cấp chứng thư số của token (L2)
enum TokenProvider {
  VNPT_CA
  VIETTEL_CA
  FPT_CA
  BKAV_CA
  MISA_CA
  EASY_CA
  OTHER
}

// Nơi giữ token hiện tại (L3)
enum TokenCustody {
  OFFICE // Tại văn phòng (kèm vị trí cất)
  CUSTOMER // Khách hàng giữ
  LOANED // Nhân viên đang mượn
  UNKNOWN // Dữ liệu chuyển đổi, chưa xác định
}

enum CredentialEventType {
  CREATED
  UPDATED // detail.fields: tên trường đổi, không có giá trị bí mật
  SECRET_CHANGED // Đổi mật khẩu / PIN (L5) — không lưu mật khẩu cũ
  STATUS_REPORTED // Người dùng báo lỗi đăng nhập (L7)
  STATUS_CHANGED
  SECRET_VIEWED // Xem (L6)
  SECRET_COPIED // Sao chép (L6)
  BORROWED
  RETURNED
  HANDED_OVER // Giao cho nhân viên khác
  RECEIVED_FROM_CUSTOMER
  RETURNED_TO_CUSTOMER
  LOCATION_CHANGED
  DELETED
}

model ClientCredential {
  id                String           @id @default(uuid()) @db.Uuid
  customerId        String           @map("customer_id") @db.Uuid
  type              CredentialType
  label             String?
  url               String?
  username          String? // Token không có tên đăng nhập
  passwordEnc       String?          @map("password_enc") // AES-256-GCM, không bao giờ trả về; token có thể không có PIN
  expiresAt         DateTime?        @map("expires_at") @db.Date // Hạn chứng thư token / hạn tài khoản
  status            CredentialStatus @default(ACTIVE)
  statusNote        String?          @map("status_note")
  note              String?
  provider          TokenProvider?
  serialNumber      String?          @map("serial_number")
  custody           TokenCustody?
  storageLocation   String?          @map("storage_location")
  holderId          String?          @map("holder_id") @db.Uuid // Người đang mượn khi custody = LOANED
  loanedAt          DateTime?        @map("loaned_at") @db.Timestamptz
  loanDueAt         DateTime?        @map("loan_due_at") @db.Date
  loanPurpose       String?          @map("loan_purpose")
  secretChangedAt   DateTime?        @map("secret_changed_at") @db.Timestamptz
  secretChangedById String?          @map("secret_changed_by_id") @db.Uuid
  revision          Int              @default(1)
  updatedById       String?          @map("updated_by_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz

  customer  Customer          @relation(fields: [customerId], references: [id])
  updatedBy User?             @relation(fields: [updatedById], references: [id])
  events    CredentialEvent[]

  @@index([customerId])
  @@index([holderId])
  @@map("client_credentials")
}

// Lịch sử và nhật ký xem/sao chép của từng tài khoản (L5–L8). Không bao giờ chứa bí mật.
model CredentialEvent {
  id           String              @id @default(uuid()) @db.Uuid
  credentialId String              @map("credential_id") @db.Uuid
  type         CredentialEventType
  actorId      String?             @map("actor_id") @db.Uuid // null với sự kiện chuyển đổi dữ liệu
  note         String?
  detail       Json?
  occurredAt   DateTime            @default(now()) @map("occurred_at") @db.Timestamptz

  credential ClientCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId, occurredAt])
  @@map("credential_events")
}
